<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HomeHatch" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/home_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.HomeHatch.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoDisplay">true</item>
    </style>

    <!-- 他のアプリの上に確認だけ出す（ショートカットの置き場所を選ぶ） -->
    <style name="Theme.HomeHatch.Overlay" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <color name="home_bg">#FF0D0E10</color>
</resources>
